def create_backup_archive() -> Path:
    stamp = time.strftime("%Y%m%d_%H%M%S")
    backup_dir = BASE_DIR / "backups"
    backup_dir.mkdir(exist_ok=True)
    archive = backup_dir / f"bot_backup_{stamp}.zip"
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.write(CACHE_DB, "music_cache.db")
        zf.write(Path(__file__), Path(__file__).name)
        # Do not include .env: it contains the live bot token.
        requirements = BASE_DIR / "requirements.txt"
        if requirements.exists():
            zf.write(requirements, "requirements.txt")
        env_example = BASE_DIR / ".env.example"
        if env_example.exists():
            zf.write(env_example, ".env.example")
        if MUSIC_CACHE_DIR.exists():
            for f in MUSIC_CACHE_DIR.rglob("*"):
                if f.is_file():
                    zf.write(f, str(Path("music_cache") / f.relative_to(MUSIC_CACHE_DIR)))
    return archive


def create_clone_archive(new_token: str) -> Path:
    """ينشئ حزمة تشغيل مطابقة مع توكن جديد وبدون الاعتماد على توكن النسخة الأصلية."""
    stamp = time.strftime("%Y%m%d_%H%M%S")
    backup_dir = BASE_DIR / "backups"
    backup_dir.mkdir(exist_ok=True)
    archive = backup_dir / f"bot_clone_{stamp}.zip"
    source = Path(__file__)
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as zf:
        zf.write(source, source.name)
        if CACHE_DB.exists():
            zf.write(CACHE_DB, "music_cache.db")
        if MUSIC_CACHE_DIR.exists():
            for f in MUSIC_CACHE_DIR.rglob("*"):
                if f.is_file():
                    zf.write(f, str(Path("music_cache") / f.relative_to(MUSIC_CACHE_DIR)))
        zf.writestr(".env", f"BOT_TOKEN={new_token}\n")
        zf.writestr("requirements.txt", "python-telegram-bot>=20.8,<23\nyt-dlp>=2025.1.15\npython-dotenv>=1.0.1\n")
        zf.writestr("README.txt", "شغّل: pip install -r requirements.txt ثم python3 " + source.name + "\n")
    return archive


