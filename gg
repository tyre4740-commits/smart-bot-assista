                added_at INTEGER NOT NULL,
                added_by INTEGER NOT NULL
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS force_subscription_channels (
                channel_id TEXT PRIMARY KEY,
                title TEXT NOT NULL,
                username TEXT,
                invite_link TEXT,
                added_at INTEGER NOT NULL,
