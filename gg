def normalize_channel(value: str) -> str:
    value = value.strip()
    if value.startswith("https://t.me/"):
        value = value.rstrip("/").split("/")[-1]
    if value.startswith("@"):
        return value
    if re.fullmatch(r"-?\d+", value):
        return value
    return "@" + value


def subscription_keyboard(channels) -> InlineKeyboardMarkup:
    rows = []
    for channel_id, title, username, invite_link in channels:
        link = invite_link or (f"https://t.me/{username}" if username else None)
        if link:
            rows.append([InlineKeyboardButton(f"📢 {title[:50]}", url=link)])
    rows.append([InlineKeyboardButton("✅ تحققت من الاشتراك", callback_data="check_subscription")])
    return InlineKeyboardMarkup(rows)


def subscription_text(channels) -> str:
    lines = ["🔒 <b>الاشتراك الإجباري</b>", "\nيجب الاشتراك في القنوات التالية أولًا ثم الضغط على زر التحقق:"]
    for _, title, username, _ in channels:
        suffix = f" (@{username.lstrip('@')})" if username else ""
        lines.append(f"• {title}{suffix}")
    return "\n".join(lines)


async def is_user_subscribed(context: ContextTypes.DEFAULT_TYPE, user_id: int) -> bool:
    if setting_get("force_subscription_enabled", "1") != "1" or is_developer(user_id):
        return True
    channels = force_subscription_channels()
    if not channels:
        return True
    for channel_id, _, _, _ in channels:
        try:
            member = await context.bot.get_chat_member(chat_id=channel_id, user_id=user_id)
            if str(member.status) not in {"member", "administrator", "creator", "ChatMemberStatus.MEMBER", "ChatMemberStatus.ADMINISTRATOR", "ChatMemberStatus.OWNER"}:
                return False
        except TelegramError as exc:
            logger.warning("force subscription check failed for %s: %s", channel_id, exc)
            return False
    return True


async def require_subscription(message, context: ContextTypes.DEFAULT_TYPE) -> bool:
    user = getattr(message, "from_user", None)
    if not user or await is_user_subscribed(context, user.id):
        return True
    channels = force_subscription_channels()
    await message.reply_text(subscription_text(channels), parse_mode=ParseMode.HTML, reply_markup=subscription_keyboard(channels))
    return False


