def init_cache() -> None:
    with sqlite3.connect(CACHE_DB) as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS music_cache (
                query_key TEXT PRIMARY KEY,
                title TEXT NOT NULL,
                telegram_file_id TEXT NOT NULL,
                file_unique_id TEXT,
                source_url TEXT,
                duration INTEGER,
                file_size INTEGER DEFAULT 0,
                cache_path TEXT,
                created_at INTEGER NOT NULL
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                first_name TEXT,
                username TEXT,
                first_seen INTEGER NOT NULL,
                last_activity INTEGER NOT NULL,
                status TEXT NOT NULL DEFAULT 'active',
                start_count INTEGER NOT NULL DEFAULT 0
            )
        """)
        # إضافة عداد /start للنسخ القديمة من قاعدة البيانات بدون حذف أي بيانات.
        try:
            db.execute("ALTER TABLE users ADD COLUMN start_count INTEGER NOT NULL DEFAULT 0")
        except sqlite3.OperationalError as exc:
            if "duplicate column name" not in str(exc).lower():
                raise
        db.execute("""
            CREATE TABLE IF NOT EXISTS bot_settings (
                key TEXT PRIMARY KEY,
                value TEXT
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS favorites (
                user_id INTEGER NOT NULL,
                query_key TEXT NOT NULL,
                title TEXT NOT NULL,
                telegram_file_id TEXT NOT NULL,
                created_at INTEGER NOT NULL,
                PRIMARY KEY (user_id, query_key)
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS download_history (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                query_key TEXT NOT NULL,
                title TEXT NOT NULL,
                source_url TEXT,
                from_cache INTEGER NOT NULL DEFAULT 0,
                created_at INTEGER NOT NULL
            )
        """)
        db.execute("""
            CREATE TABLE IF NOT EXISTS managed_chats (
