            )
        """)
        db.commit()

        # دعم قواعد البيانات القديمة بدون حذف أي بيانات موجودة.
        columns = {row[1] for row in db.execute("PRAGMA table_info(music_cache)").fetchall()}
        for name, definition in (
            ("source_url", "TEXT"),
