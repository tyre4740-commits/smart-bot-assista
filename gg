def format_size(size: int) -> str:
    value = float(size or 0)
    for unit in ("B", "KB", "MB", "GB"):
        if value < 1024 or unit == "GB":
            return f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} GB"


def normalize_query(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r"\s+", " ", value)
    return value


def favorite_callback_key(value: str) -> str:
    """مفتاح قصير وآمن ضمن حد Telegram للـ callback_data (64 بايت)."""
    return hashlib.sha256(normalize_query(value).encode("utf-8")).hexdigest()[:20]


def is_url(value: str) -> bool:
    try:
        parsed = urlparse(value)
        return parsed.scheme in {"http", "https"} and bool(parsed.netloc)
    except ValueError:
        return False


def clean_title(value: str) -> str:
    value = re.sub(r'[\\/:*?"<>|\n\r\t]+', "_", value)
    value = re.sub(r"\s+", " ", value).strip(" .")
    return (value or "audio")[:160]


def yt_options() -> dict:
    # إعدادات أسرع وأكثر تحملاً لانقطاعات SSL مع YouTube.
    # لا نفرض IPv4 لأن بعض الخوادم/الشبكات تعطي EOF عند إجباره.
    return {
        "quiet": True,
        "no_warnings": True,
        "noplaylist": True,
        "socket_timeout": 12,
        "retries": 4,
        "fragment_retries": 3,
        "extractor_retries": 4,
        "file_access_retries": 2,
        "cachedir": False,
        "overwrites": True,
    }


def short_error(exc: Exception) -> str:
    text = " ".join(str(exc).split())
    low = text.lower()
    if "sign in" in low or "not a bot" in low:
        return "YouTube طلب تسجيل الدخول أو منع الطلب الآلي"
    if "private video" in low or "members-only" in low:
        return "الفيديو خاص أو للأعضاء فقط"
    if "http error 403" in low or "403 forbidden" in low:
        return ("YouTube رفض طلب التنزيل (403). حدّث yt-dlp إلى أحدث إصدار على الاستضافة "
                "ثم أعد المحاولة؛ بعض الفيديوهات قد تبقى محجوبة من جهة YouTube.")
    if "file is larger than" in low or "maximum file size" in low:
        return "حجم الملف أكبر من الحد المسموح."
    return text[:220] or "خطأ غير معروف"


def download_audio_sync(query: str, workdir: str) -> tuple[str, str, str, int | None]:
    if is_url(query):
        source = query
        selected_title = "audio"
    else:
        # نبحث عن أول نتيجة فقط: هذا يقلل زمن الاستجابة بشكل واضح.
        simplified = re.sub(r"[()\[\]{}]", " ", query)
        simplified = re.sub(r"\s+", " ", simplified).strip()
        search_queries = list(dict.fromkeys([query, simplified]))
        entries = []
        last_search_error = None

        for search_query in search_queries:
            # محاولات قصيرة مستقلة؛ إذا حصل SSL EOF نعيد الاتصال بدل إيقاف الطلب فوراً.
            for attempt in range(3):
                try:
                    search_options = yt_options()
                    search_options.update({
                        "extract_flat": True,
                        "skip_download": True,
                    })
                    with yt_dlp.YoutubeDL(search_options) as ydl:
                        search_result = ydl.extract_info(
                            f"ytsearch1:{search_query}", download=False
                        )
                    entries = [
                        item for item in (search_result or {}).get("entries", [])
                        if item
                    ]
                    if entries:
                        break
                except Exception as exc:
                    last_search_error = exc
                    if attempt < 2:
                        time.sleep(0.35 * (attempt + 1))
            if entries:
                break

        if not entries:
            error_text = short_error(last_search_error) if last_search_error else "لا توجد نتائج"
            if "unexpected_eof" in error_text.lower() or "ssl" in error_text.lower():
                raise BotError("تعذر الاتصال بـ YouTube مؤقتًا. أعد المحاولة بعد لحظات.")
            raise BotError(f"فشل البحث في YouTube: {error_text}")

        first = entries[0]
        source = (
            first.get("webpage_url")
            or first.get("original_url")
            or first.get("url")
        )
        if source and not str(source).startswith(("http://", "https://")):
            source = f"https://www.youtube.com/watch?v={source}"
        if not source:
            raise BotError("نتيجة البحث لا تحتوي على رابط قابل للتنزيل.")
        selected_title = first.get("title") or "audio"

    # اسم الملف مبني على معرّف الفيديو لتجنب أسماء طويلة أو رموز غير صالحة.
    output_template = str(Path(workdir) / "%(id)s.%(ext)s")
    options = yt_options()
    options["outtmpl"] = output_template
    options["http_headers"] = {
        "User-Agent": (
            "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 "
            "Chrome/124.0 Mobile Safari/537.36"
        ),
        "Referer": "https://www.youtube.com/",
    }

    # فضّل M4A لتوافق Telegram، لكن اسمح بأي مسار صوتي متاح بدل فشل
    # كل نتيجة لا تحتوي على M4A. لا يتم إجراء تحويل بواسطة FFmpeg.
    options["format"] = "bestaudio[ext=m4a]/bestaudio/best[ext=m4a]/best"
    last_error = None
    try:
        with yt_dlp.YoutubeDL(options) as ydl:
            info = ydl.extract_info(source, download=True)
            title = clean_title(info.get("title") or selected_title)
    except Exception as exc:
        last_error = exc
        for partial in Path(workdir).glob("*.part"):
            partial.unlink(missing_ok=True)
        raise BotError(f"فشل تنزيل الصوت من YouTube: {short_error(last_error)}") from last_error

    extensions = {".mp3", ".m4a", ".webm", ".opus", ".ogg", ".aac", ".mp4"}
    files = [
        p for p in Path(workdir).iterdir()
        if p.is_file() and p.suffix.lower() in extensions and not p.name.endswith(".part")
    ]
    if not files:
        raise BotError("لم يُنشأ ملف صوتي قابل للإرسال. جرّب رابطًا آخر أو حدّث yt-dlp.")
    path = max(files, key=lambda p: p.stat().st_mtime)
    if path.suffix.lower() not in {".mp3", ".m4a", ".mp4", ".webm", ".opus", ".ogg", ".aac"}:
        raise BotError("صيغة الملف الناتج غير مدعومة. جرّب رابطًا آخر.")
    duration = None
    try:
        duration_value = info.get("duration")
        duration = int(duration_value) if duration_value else None
    except Exception:
        pass
    return str(path), title, str(source), duration


def parse_query(text: str) -> str | None:
    patterns = (
        r"^يوت\s+(.+)$",
        r"^/yt(?:@\w+)?\s+(.+)$",
        r"^/youtube(?:@\w+)?\s+(.+)$",
    )
    for pattern in patterns:
        match = re.match(pattern, text.strip(), flags=re.IGNORECASE | re.DOTALL)
        if match and match.group(1).strip():
            return match.group(1).strip()
    return None


