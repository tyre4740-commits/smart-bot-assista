async def developer_callback(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    q = update.callback_query
    if not q:
        return
    user_id = q.from_user.id
    action = q.data
    await q.answer()

    # User features
    if action == "my_favorites":
        rows = favorite_list(user_id)
        if not rows:
            await q.message.reply_text("⭐ لا توجد أغاني في المفضلة حاليًا.")
            return
        lines = ["⭐ <b>مُفضلتك</b>\n"]
        for i, (title, key, file_id) in enumerate(rows[:20], 1):
            lines.append(f"{i}. 🎵 {title}")
        await q.message.reply_text("\n".join(lines), parse_mode=ParseMode.HTML)
        return

    if action == "my_history":
        rows = history_list(user_id, 15)
        if not rows:
            await q.message.reply_text("📥 لا يوجد سجل تحميلات حتى الآن.")
            return
        lines = ["📥 <b>سجل التحميلات</b>\n"]
        for i, (title, created_at, from_cache) in enumerate(rows, 1):
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(created_at))
            source = "⚡ كاش" if from_cache else "⬇️ تحميل"
            lines.append(f"{i}. {title}\n   {source} • {when}")
        await q.message.reply_text("\n".join(lines), parse_mode=ParseMode.HTML)
        return

    if action.startswith("fav:"):
        token = action[4:]
        query_key = None

        # نحل المفتاح القصير إلى query_key الحقيقي؛ لا نضع نص البحث نفسه داخل callback_data.
        with sqlite3.connect(CACHE_DB) as db:
            favorite_rows = db.execute(
                "SELECT query_key FROM favorites WHERE user_id=?", (user_id,)
            ).fetchall()
            for (candidate,) in favorite_rows:
                if favorite_callback_key(candidate) == token:
                    query_key = candidate
                    break

            if query_key is None:
                cache_rows = db.execute(
                    "SELECT query_key FROM music_cache"
                ).fetchall()
                for (candidate,) in cache_rows:
                    if favorite_callback_key(candidate) == token:
                        query_key = candidate
                        break

        if not query_key:
            await q.answer("⚠️ الأغنية لم تعد موجودة في الكاش.", show_alert=True)
            return

        if favorite_has(user_id, query_key):
            favorite_remove(user_id, query_key)
            await q.answer("تم إزالتها من المفضلة")
            try:
                await q.edit_message_reply_markup(
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton(
                            "⭐ مُفضلة",
                            callback_data=f"fav:{favorite_callback_key(query_key)}"
                        )]
                    ])
                )
            except Exception:
                pass
            return

        with sqlite3.connect(CACHE_DB) as db:
            row = db.execute(
                "SELECT title, telegram_file_id FROM music_cache WHERE query_key=?",
                (query_key,)
            ).fetchone()

        if row:
            favorite_add(user_id, query_key, row[0], row[1])
            await q.answer("تمت إضافتها إلى المفضلة")
            try:
                await q.edit_message_reply_markup(
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton(
                            "💫 إزالة من المفضلة",
                            callback_data=f"fav:{favorite_callback_key(query_key)}"
                        )]
                    ])
                )
            except Exception:
                pass
        else:
            await q.answer("⚠️ الأغنية لم تعد موجودة في الكاش.", show_alert=True)
        return

    if action == "check_subscription":
        if await is_user_subscribed(context, user_id):
            await q.answer("✅ تم التحقق، يمكنك استخدام البوت الآن.", show_alert=True)
            await q.message.reply_text("✅ تم التحقق من اشتراكك. أرسل طلبك الآن.")
        else:
            await q.answer("❌ لم يكتمل الاشتراك في كل القنوات.", show_alert=True)
        return

    # Developer-only features
    if not is_developer(user_id):
        await q.answer("🚫 غير مصرح لك.", show_alert=True)
        return

    if action == "dev_panel":
        context.user_data.pop("dev_action", None)
        await show_developer_panel(q)
        return

    if action in {"music_ops", "music_ops_refresh"}:
        try:
            payload = await asyncio.to_thread(website_call, "GET", "/api/bot/requests?limit=8")
            website_requests = payload.get("requests", [])
            status_counts = {"queued": 0, "processing": 0, "accepted": 0, "failed": 0}
            for item in website_requests:
                status = str(item.get("status", "failed"))
                if status in status_counts:
                    status_counts[status] += 1
                elif status == "bot_activation_required":
                    status_counts["failed"] += 1
            website_line = "\n".join(
                f"• {str(item.get('query', 'طلب'))[:42]} — {item.get('status', 'unknown')}"
                for item in website_requests[:6]
            ) or "لا توجد طلبات في طابور الموقع."
            website_error = ""
        except Exception as exc:
            status_counts = {"queued": 0, "processing": 0, "accepted": 0, "failed": 0}
            website_line = "تعذر قراءة طابور الموقع حاليًا."
            website_error = f"\n⚠️ {short_error(exc)[:120]}"
        _, _, _, songs, cache_size, downloads, favorites, history, _ = stats()
        text = (
            "🎵 <b>Music Operations Center</b>\n\n"
            "<b>طابور الموقع</b>\n"
            f"⏳ بانتظار البوت: <b>{status_counts['queued']}</b>\n"
            f"⚙️ قيد المعالجة: <b>{status_counts['processing']}</b>\n"
            f"✅ تم الإرسال: <b>{status_counts['accepted']}</b>\n"
            f"⚠️ يحتاج متابعة: <b>{status_counts['failed']}</b>\n\n"
            f"<b>آخر العمليات</b>\n{website_line}{website_error}\n\n"
            "<b>المحرك المحلي</b>\n"
            f"🎼 الكاش: <b>{songs}</b> · 💾 {format_size(cache_size)}\n"
            f"📥 التحميلات: <b>{downloads}</b> · ⭐ المفضلات: <b>{favorites}</b> · 🧾 السجل: <b>{history}</b>"
        )
        markup = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔄 تحديث العمليات", callback_data="music_ops_refresh")],
            [InlineKeyboardButton("⬅️ مركز المطور", callback_data="dev_panel")],
        ])
        await edit_developer_message(q, text, markup)
        return

    if action == "secondary_devs":
        rows = secondary_developer_list()
        text = "👨‍💻 <b>المطورون الثانويون</b>\n\n"
        if rows:
            text += "\n".join(f"• <code>{uid}</code>" for uid, _ in rows)
        else:
            text += "لا يوجد مطور ثانوي حاليًا."
