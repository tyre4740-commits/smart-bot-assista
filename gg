def optimize_database() -> str:
    with sqlite3.connect(CACHE_DB) as db:
        integrity = db.execute("PRAGMA integrity_check").fetchone()[0]
        if integrity != "ok":
            return f"❌ فشل فحص قاعدة البيانات: {integrity}"
        db.execute("PRAGMA optimize")
        db.execute("VACUUM")
        db.commit()
    removed = 0
    known = set()
    with sqlite3.connect(CACHE_DB) as db:
        for (path,) in db.execute("SELECT cache_path FROM music_cache WHERE cache_path IS NOT NULL").fetchall():
            if path:
                known.add(str(Path(path).resolve()))
    if MUSIC_CACHE_DIR.exists():
        for f in MUSIC_CACHE_DIR.rglob("*"):
            if f.is_file() and str(f.resolve()) not in known:
                try:
                    f.unlink(); removed += 1
                except OSError:
                    pass
    return f"✅ تم التحسين بنجاح.\n🧹 ملفات كاش غير مرتبطة: {removed}"


def broadcast_targets(kind: str):
    with sqlite3.connect(CACHE_DB) as db:
        if kind == "private":
            return [r[0] for r in db.execute("SELECT user_id FROM users WHERE status != 'blocked'").fetchall()]
        if kind == "groups":
            return [r[0] for r in db.execute("SELECT chat_id FROM managed_chats WHERE chat_type LIKE '%كروب%' AND last_status='added'").fetchall()]
        if kind == "channels":
            return [r[0] for r in db.execute("SELECT chat_id FROM managed_chats WHERE chat_type LIKE '%قناة%' AND last_status='added'").fetchall()]
        private = [r[0] for r in db.execute("SELECT user_id FROM users WHERE status != 'blocked'").fetchall()]
        chats = [r[0] for r in db.execute("SELECT chat_id FROM managed_chats WHERE last_status='added'").fetchall()]
        return private + chats


