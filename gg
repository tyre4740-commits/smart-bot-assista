async def handle_request(message, query: str, context: ContextTypes.DEFAULT_TYPE) -> bool:
    register_user(getattr(message, "from_user", None))
    if setting_get("bot_enabled", "1") != "1" and not is_developer(getattr(message.from_user, "id", None)):
        await message.reply_text("🔴 البوت متوقف مؤقتًا من قبل الإدارة.")
        return False
    play_photo = setting_get("play_photo")
    if play_photo:
        status = await message.reply_photo(photo=play_photo, caption="🪄")
    else:
        status = await message.reply_text("🪄")

    # مؤثر حالة الطلب: 🪄 → 🎼 → 🎵
    try:
        await asyncio.sleep(0.35)
        await status.edit_caption(caption="🎼") if play_photo else await status.edit_text("🎼")
        await asyncio.sleep(0.35)
        await status.edit_caption(caption="🎵") if play_photo else await status.edit_text("🎵")
    except Exception:
        pass

    async def progress_loop():
        # يعطي المستخدم استجابة واضحة بدل بقاء الرسالة ثابتة أثناء YouTube.
        frames = ["🪄", "🪄", "🪄"]
        i = 0
        while True:
            await asyncio.sleep(1.6)
            i = (i + 1) % len(frames)
            try:
                if status.photo:
                    await status.edit_caption(caption=frames[i], parse_mode=ParseMode.HTML)
                else:
                    await status.edit_text(frames[i], parse_mode=ParseMode.HTML)
            except Exception:
                return

    progress_task = asyncio.create_task(progress_loop())
    workdir = tempfile.mkdtemp(prefix="ytbot_")
    try:
        # هذه هي حالة 1-2 ثانية: Telegram يعيد إرسال الملف من file_id دون YouTube.
        cached = cache_get(query)
        if cached:
            try:
                await send_cached(message, cached[0], cached[1], query)
                add_download_history(message.from_user.id, query, cached[0], cached[2], True)
                increment_downloads()
                return True
            except Exception as exc:
                logger.warning("cached file_id failed; invalidating cache entry and re-downloading: %s", exc)
                # لا نترك file_id تالفًا في قاعدة البيانات؛ وإلا ستفشل الأغنية
                # نفسها في كل مرة. نحذف سجل الأغنية فقط ولا نحذف بقية الكاش.
                with sqlite3.connect(CACHE_DB) as db:
                    db.execute(
                        "DELETE FROM music_cache WHERE query_key=?",
                        (normalize_query(query),),
                    )
                    db.commit()

        async with DOWNLOAD_SEMAPHORE:
            await message.chat.send_action(ChatAction.UPLOAD_DOCUMENT)
            path, title, source_url, duration = await asyncio.to_thread(
                download_audio_sync, query, workdir
            )

        if os.path.getsize(path) > MAX_FILE_SIZE_BYTES:
            raise BotError(f"الملف أكبر من الحد المسموح {MAX_FILE_SIZE_MB} MB.")

        with open(path, "rb") as audio_file:
            sent = await message.reply_audio(
                audio=audio_file,
                title=title,
                performer="YouTube",
                caption=success_caption(),
                parse_mode=ParseMode.HTML,
                reply_markup=InlineKeyboardMarkup([
                    [InlineKeyboardButton("⭐ مُفضلة", callback_data=f"fav:{favorite_callback_key(query)}")]
                ]),
                read_timeout=180,
                write_timeout=180,
                connect_timeout=30,
                pool_timeout=30,
            )

        if sent.audio and sent.audio.file_id:
            cache_file = MUSIC_CACHE_DIR / f"{abs(hash(normalize_query(query)))}{Path(path).suffix.lower()}"
            try:
                shutil.copy2(path, cache_file)
            except Exception:
                cache_file = Path(path)
            cache_put(
                query, title, sent.audio.file_id, sent.audio.file_unique_id,
                source_url, duration, os.path.getsize(path), str(cache_file)
            )
            add_download_history(message.from_user.id, query, title, source_url, False)
            increment_downloads()
            await notify_developer(
                context,
                f"🎵 تحميل جديد\\n👤 المستخدم: {message.from_user.id}\\n🎶 {title}"
            )
        return True

    except BotError as exc:
        # رسالة موحدة عند تعذر توفير الأغنية، مع أزرار المطور والبوت.
        bot_username = (getattr(context.bot, "username", None) or "").strip().lstrip("@")
        keyboard_rows = [[
            InlineKeyboardButton("🔴 المطوّر @sjxn_200", url="https://t.me/sjxn_200")
        ]]
        if bot_username:
            keyboard_rows.append([
                InlineKeyboardButton(f"🔵 البوت @{bot_username}", url=f"https://t.me/{bot_username}")
            ])
        await message.reply_text(
            f"للأسف، الأغنية «{clean_title(query)}» مفروضة عليها قيود من البوت لسبب شخصي.",
            reply_markup=InlineKeyboardMarkup(keyboard_rows),
        )
    except Exception as exc:
        # لا نسمح لفشل طلب واحد بإنهاء معالج التحديثات؛ نسجل traceback للتشخيص.
        logger.exception("download/send failed for query=%r user_id=%s", query, getattr(getattr(message, "from_user", None), "id", None))
        try:
            await message.reply_text(f"فشل تنفيذ الطلب، والبوت ما زال يعمل:\n{short_error(exc)}")
        except Exception:
            logger.exception("could not send request-failure message to Telegram")
        return False
    finally:
        progress_task.cancel()
        try:
            await progress_task
        except asyncio.CancelledError:
            pass
        try:
            await status.delete()
        except Exception:
            pass
        shutil.rmtree(workdir, ignore_errors=True)



